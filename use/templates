template<typename T>
void printValue(T value) {
    std::cout << value  << "\n";
}

template<>
void printValue<bool>(bool value) {
    if(value){
    std::cout << "true"  <<"\n";
    return;
    }
    std::cout << "false" << "\n";
}

template<>
void printValue<char*>(char* value) {
    std::cout <<"["  << "\""<<  value<< "]" << "\""<< std::endl;
}


