std::vector<int> mergeSortedVectors(std::vector<int>& vec1, std::vector<int>& vec2 ){
    
    int i = 0;
    int j = 0;
    int k = 0;
    std::vector<int> vec3(vec1.size() + vec2.size());
    while(vec1.size() + vec2.size() > i){
        
        if (j >= vec1.size()) {
            vec3[i] = vec2[k];
            k++;
        }
        else if (k >= vec2.size()) {
            vec3[i] = vec1[j];
            j++;
        }
        else if (vec1[j] > vec2[k]) {
            vec3[i] = vec2[k];
            k++;
        }
        else {
            vec3[i] = vec1[j];
            j++;
        }
        
        
        
        i++;
    }
    return vec3;
}


int findSubsequence(std::vector<int>& vec1, std::vector<int>& vec2) {
    for (int i = 0; i <= vec1.size() - vec2.size(); i++) {
    bool found = true;

    for (int j = 0; j < vec2.size(); j++) {
        if (vec1[i + j] != vec2[j]) {
            found = false;
            break;
        }
    }

    if (found) {
        return i;
    }
}

return -1;
}



std::vector<std::vector<int>> groupAdjacent(std::vector<int>& vec1){
    
    
    std::vector<std::vector<int>> groups;
    
    std::vector<int> group;
    for (int i = 0; i < vec1.size(); i++) {
    if(group.empty() || vec1[i] == vec1[i-1]){
        group.push_back(vec1[i]);
    }
    else{
        
        groups.push_back(group);
        group.clear();
        group.push_back(vec1[i]);
        
    }
    }
    
    groups.push_back(group);
    
    return groups;
    
}


bool isEven(int x) {
    return x % 2 == 0;
}

template<typename T>
std::vector<T> filterVector(bool (*pred)(T), const std::vector<T>& vec) {
    std::vector<T> vec1;

    for (int i = 0; i < vec.size(); i++) {
        if (pred(vec[i])) {
            vec1.push_back(vec[i]);
        }
    }

    return vec1;
}



