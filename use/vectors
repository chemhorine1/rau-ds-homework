int removeElementsGreaterThan(std::vector<int>& vec, int y){
    int udalyonnie = 0;
    int size = vec.size();
    while(y < vec[vec.size()-1]){
        vec.pop_back();
        udalyonnie++;
    }
    return udalyonnie;
}


void manageCapacity(std::vector<int>& vec){
    
    std::cout << "\n" << vec.capacity() << " " << vec.size()<< "\n"; 
    vec.reserve(vec.size() + 500);
    for (int i = 0; i < 500; i++) {
        vec.push_back(i+1);
        
        
    }
    std::cout << "\n" << vec.capacity() << " " << vec.size()<< "\n"; 
    
}


